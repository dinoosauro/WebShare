<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.WebShare" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">@color/accent_light</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/accent_light</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorSecondary">@color/accent_light</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/accent_light</item>
        <item name="colorOnSecondaryContainer">@color/black</item>
        <item name="colorTertiary">@color/accent_light</item>
        <item name="colorOnTertiary">@color/black</item>

        <!-- Surface colors - this controls AppBarLayout -->
        <item name="colorSurface">@color/dark_background</item>
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorOutline">@color/light_background</item>
        <item name="colorSurfaceContainerHighest">@color/dark_card_highest</item>
        <item name="colorSurfaceContainerHigh">@color/dark_card</item>
        <item name="colorOnSurfaceVariant">@color/dark_second_text</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:textColor">@color/white</item>

        <item name="android:fontFamily">@font/work_sans</item>
    </style>
</resources>